{
  "name": "empire-streets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D open-world driving and crime sandbox in an NYC-inspired city. Three.js + Rapier physics + TypeScript + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.ts",
    "creatures": "tsx scripts/build-creatures.ts",
    "validate:glb": "node scripts/validate-glb.mjs",
    "tuning:example": "tsx scripts/tuning-example.js",
    "race:example": "tsx scripts/race-example.js",
    "flee:example": "tsx scripts/flee-example.ts",
    "heist:example": "tsx scripts/heist-example.ts",
    "events:example": "tsx scripts/street-events-example.ts",
    "living:example": "tsx scripts/living-world-example.ts",
    "campaign:example": "tsx scripts/campaign-example.ts",
    "android:sync": "bash scripts/android-sync.sh",
    "build:android": "npm run build && bash scripts/android-sync.sh",
    "build:esbuild": "tsc --noEmit && node scripts/build-esbuild.mjs",
    "build:android:esbuild": "npm run build:esbuild && bash scripts/android-sync.sh"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "gltf-validator": "^2.0.0-dev.3.10"
  }
}
